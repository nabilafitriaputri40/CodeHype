# Railway/Render: set these in the dashboard Variables/Environment, then redeploy.
UPSTREAM_ORIGIN=https://www.codehype.ai
UPSTREAM_ALIASES=https://codehype.ai,http://www.codehype.ai,http://codehype.ai
# IMPORTANT: replace with YOUR final custom domain, with https and no path.
PUBLIC_ORIGIN=https://your-domain.example
NODE_ENV=production
ENABLE_INDEXING=true
CANONICAL_MODE=mirror

# Railway/Render supply PORT automatically. For VPS/local only:
# PORT=3000
HOST=0.0.0.0
# Behind Railway/Render/Caddy: true. Only accept traffic through that trusted proxy.
TRUST_PROXY=true

# Read-only public mirror by default. Enable BOTH only for authorized app integration.
# OAuth callbacks, email links and payment flows need configuration in the original backend too.
ALLOW_WRITE_METHODS=false
PROXY_COOKIES=false

# Comma-separated additional sitemap paths, including unusual root paths from your source.
# Source robots.txt and sitemap indexes are discovered automatically.
SITEMAP_PATHS=/sitemap.xml
SITEMAP_CACHE_SECONDS=300
# Probe up to 30 previously unverified URLs per map refresh; fix canonical aliases / remove 404/noindex.
# Remaining entries stay as supplied until later refreshes. See README for full-audit limits.
SITEMAP_VALIDATE_LIMIT=30
SITEMAP_VALIDATION_BUDGET_MS=8000
SITEMAP_VALIDATION_CONCURRENCY=4
SITEMAP_PROBE_TTL_SECONDS=3600
STRIP_TRACKING_CANONICAL=true
NOINDEX_PATH_PREFIXES=/search,/admin,/settings,/my-launches,/auth,/api,/login,/signup,/pricing/checkout,/pricing/success,/pricing/cancel

# Optional: paste the content attribute of YOUR Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=
PAGE_OVERRIDES_FILE=config/pages.json
REDIRECTS_FILE=config/redirects.json
VERIFICATION_FILES=config/verification-files.json

UPSTREAM_TIMEOUT_MS=20000
MAX_TEXT_BYTES=16777216
MAX_REQUEST_BYTES=8388608
HTML_CACHE_SECONDS=30
CACHE_MAX_MB=64
LOG_REQUESTS=true
# Upstream CSP hashes/origins can become invalid after rewriting. Default: omit upstream CSP.
# Set true only after configuring a compatible source CSP and testing the mirror.
KEEP_UPSTREAM_CSP=false
# Optional extra robots lines (literal \n is expanded). Source rules are retained.
ROBOTS_APPEND=
