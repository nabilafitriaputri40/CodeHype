[Unit]
Description=Portable SEO Mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirror
Group=mirror
WorkingDirectory=/opt/portable-seo-mirror
Environment=NODE_ENV=production
EnvironmentFile=/opt/portable-seo-mirror/.env
ExecStart=/usr/bin/node /opt/portable-seo-mirror/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
